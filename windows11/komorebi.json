{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 10,
  "default_container_padding": 2,
  "border": true,
  "border_width": 2,
  "border_offset": -1,
  "border_style": "Square",
  "border_implementation": "Komorebi",
  "border_colours": {
    "single": "#00D9B0",
    "stack": "#00D9B0",
    "monocle": "#00D9B0",
    "floating": "#00D9B0",
    "unfocused": "#595959",
    "unfocused_locked": "#595959"
  },
  "animation": {
    "enabled": false
  },
  "mouse_follows_focus": true,
  "resize_delta": 32,
  "window_container_behaviour": "Create",
  "float_override": false,
  "transparency": false,
  "remove_titlebar_applications": [
    {
      "kind": "Exe",
      "id": ".*",
      "matching_strategy": "Regex"
    }
  ],
